# ========================
# Required Configuration
# ========================

# Database Configuration (Required)
DATABASE_URL=postgresql://username:password@localhost:5432/edrp_db

# Security (Required)
# Generate a strong secret key: `openssl rand -hex 32`
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440  # 24 hours

# Domain Configuration (Required for subdomains)
# Set this to your main domain (e.g., example.com)
# For local development, use 'localhost'
ROOT_DOMAIN=localhost

# ========================
# Optional Configuration
# ========================

# Email Configuration (Optional)
SMTP_SERVER=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=your-email-password
EMAIL_FROM=no-reply@example.com

# Paystack Payment Gateway (Optional)
PAYSTACK_SECRET_KEY=your_paystack_secret_key_here
PAYSTACK_PUBLIC_KEY=your_paystack_public_key_here

# Redis (Optional, needed for caching/background tasks)
REDIS_URL=redis://localhost:6379

# File Uploads (Optional)
MAX_FILE_SIZE=10485760  # 10MB in bytes
UPLOAD_DIR=uploads

# Firebase Cloud Messaging (Optional, for push notifications)
FCM_SERVER_KEY=your_fcm_server_key_here

# Location verification (Optional)
LOCATION_TOLERANCE_METERS=100

# ========================
# Environment
# ========================
# Set to 'production' in production
ENVIRONMENT=development
